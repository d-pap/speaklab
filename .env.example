# Copy to .env in the project root. Relative data paths resolve from this file's directory.
SPEAKLAB_DATA_DIR=./data
SPEAKLAB_OLLAMA_URL=http://127.0.0.1:11434
# Initial model; a selection saved in the web Settings overrides this default.
SPEAKLAB_OLLAMA_MODEL=qwen3.5:9b-q4_K_M
SPEAKLAB_WHISPER_URL=http://127.0.0.1:8080
SPEAKLAB_MODEL_TIMEOUT=180
SPEAKLAB_OLLAMA_CONTEXT=8192
SPEAKLAB_OLLAMA_MAX_OUTPUT=2048
# Set true after building the frontend to serve it through the backend's localhost port.
SPEAKLAB_SERVE_FRONTEND=false
SPEAKLAB_SERVER_NAME=This computer
# Optional private HTTPS browser origins (JSON array); keep model URLs on loopback.
# SPEAKLAB_BROWSER_ORIGINS=["https://your-pc.your-tailnet.ts.net"]
